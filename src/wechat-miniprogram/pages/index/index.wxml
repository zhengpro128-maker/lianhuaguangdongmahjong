<web-view
  wx:if="{{!failed}}"
  src="{{webUrl}}"
  bindload="handleLoad"
  binderror="handleError"
></web-view>

<view wx:else class="load-error">
  <view class="load-error__panel">
    <text class="load-error__title">游戏加载失败</text>
    <text class="load-error__detail">{{errorText}}</text>
    <button class="load-error__retry" bindtap="retry">重新加载</button>
  </view>
</view>
