# 标准小程序 web-view 加载的正式网页。必须使用 HTTPS，并在小程序后台登记为业务域名。
VITE_WECHAT_WEB_URL=https://lianhuaguangdongmahjong.guoguo-labs.online/
# 旧版原生 Canvas 小游戏的生产 API 根地址，仅 build:wechat-game 使用。
VITE_WECHAT_API_BASE=https://api.example.com
# 微信公众平台“开发设置”中的小程序 AppID，用于生成 project.config.json。
VITE_WECHAT_APP_ID=wx0000000000000000
